<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_whatsmarketing" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.whatsmarketing</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_send_whatsmarketing_message"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-whatsapp">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Send WhatsApp</span>
                    </div>
                </button>
                <button name="action_view_whatsmarketing_messages"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-comments">
                    <field name="whatsmarketing_message_count" widget="statinfo" string="Messages"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
