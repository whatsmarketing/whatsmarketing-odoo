<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsmarketing_message_tree" model="ir.ui.view">
        <field name="name">whatsmarketing.message.tree</field>
        <field name="model">whatsmarketing.message</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Messages">
                <field name="create_date" string="Sent At"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="phone_number"/>
                <field name="message_type"/>
                <field name="message_body"/>
                <field name="status"
                       decoration-success="status == 'sent'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'pending'"
                       widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_whatsmarketing_message_form" model="ir.ui.view">
        <field name="name">whatsmarketing.message.form</field>
        <field name="model">whatsmarketing.message</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Message">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Sent At" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="wa_message_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="phone_number" readonly="1"/>
                            <field name="message_type" readonly="1"/>
                        </group>
                    </group>
                    <group string="Message Content">
                        <field name="message_body" nolabel="1" readonly="1"/>
                    </group>
                    <group string="API Response" groups="base.group_no_one">
                        <field name="api_response" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsmarketing_message" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">whatsmarketing.message</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No WhatsApp messages sent yet
            </p>
            <p>
                Send your first WhatsApp message from a Contact or Lead.
            </p>
        </field>
    </record>

    <menuitem id="menu_whatsmarketing_root"
              name="WhatsMarketing"
              sequence="100"/>

    <menuitem id="menu_whatsmarketing_messages"
              name="Message Log"
              parent="menu_whatsmarketing_root"
              action="action_whatsmarketing_message"
              sequence="10"/>
</odoo>
